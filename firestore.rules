rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(code) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/deadaimRooms/$(code)).data.members;
    }
    match /deadaimRooms/{code} {
      // Knowing an unguessable invitation code grants the ability to join, not list rooms.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[a-f0-9]{24}$')
        && request.resource.data.keys().hasOnly(['members','createdAt'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 20
        && request.resource.data.members.toSet().size() == request.resource.data.members.size()
        && ((!(request.auth.uid in resource.data.members)
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()))
          || (request.auth.uid in resource.data.members
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())));
      allow delete: if false;
      match /results/{id} {
        allow read: if member(code);
        allow create: if member(code) && validResult();
        // Idempotent retries may change only the server timestamp, never the result.
        allow update: if member(code) && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        function validResult() {
          let d = request.resource.data;
          return d.keys().hasAll(['uid','name','mode','difficulty','duration','hits','shots','accuracy','avgMs','createdAt'])
            && d.keys().hasOnly(['uid','name','mode','difficulty','duration','hits','shots','accuracy','avgMs','createdAt'])
            && d.uid == request.auth.uid
            && d.name is string && d.name.size() > 0 && d.name.size() <= 24
            && d.mode in ['flick','micro','track','head','strafe']
            && d.difficulty in ['easy','normal','hard']
            && d.duration in [30,60,120]
            && d.hits is int && d.hits >= 0 && d.hits <= 10000
            && d.shots is int && d.shots >= d.hits && d.shots <= 10000
            && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100
            && d.avgMs is int && d.avgMs >= 0 && d.avgMs <= 120000
            && d.createdAt == request.time;
        }
      }
    }
  }
}
